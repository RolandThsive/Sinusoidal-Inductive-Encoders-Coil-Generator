(kicad_pcb (version 20221018) (generator coil_generator)

  (general (thickness 1.6))

  (paper "User" 200.0 200.0)
  (title_block (title "Every via kind") (comment 1 "through, blind, buried, micro"))

  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" signal)
    (2 "In2.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (44 "Edge.Cuts" user)
  )

  (setup (pad_to_mask_clearance 0))

  (net 0 "")
  (net 1 "SIN_1")
  (net 2 "COS_1")

  (segment (start 90 100) (end 110 100) (width 0.2) (layer "F.Cu") (net 1))
  (segment (start 100 95) (end 100 105) (width 0.25) (layer "In1.Cu") (net 2))
  (segment (start 95 95) (end 105 95) (width 0.15) (layer "In2.Cu") (net 2))
  (segment (start 92 104) (end 108 104) (width 0.3) (layer "B.Cu") (net 1))
  (via (at 90 100) (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 1))
  (via blind (at 110 100) (size 0.6) (drill 0.3) (layers "F.Cu" "In2.Cu") (net 1))
  (via blind (at 100 95) (size 0.6) (drill 0.3) (layers "In1.Cu" "In2.Cu") (net 2))
  (via micro (at 100 105) (size 0.3) (drill 0.1) (layers "F.Cu" "In1.Cu") (net 2))
  (gr_circle (center 100 100) (end 115 100) (layer "Edge.Cuts") (width 0.05) (fill none))
  (gr_circle (center 100 100) (end 102 100) (layer "Edge.Cuts") (width 0.05) (fill none))
)
